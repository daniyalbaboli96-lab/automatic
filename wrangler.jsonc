{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "automatic",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "69836b59-ac70-47c8-8bfa-3af2a560c626","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "417b4d71009c41539cd216b4043f68da" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
